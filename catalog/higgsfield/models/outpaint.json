{
  "display_name": "Outpaint",
  "job_type": "outpaint",
  "params": [
    {
      "name": "aspect_ratio",
      "type": "string",
      "default": "21:9",
      "required": false,
      "enum": [
        "auto",
        "1:1",
        "3:2",
        "2:3",
        "4:3",
        "3:4",
        "4:5",
        "5:4",
        "9:16",
        "16:9",
        "21:9"
      ]
    },
    {
      "name": "folder_id",
      "type": "string|null",
      "default": null,
      "required": false
    },
    {
      "name": "image_references",
      "type": "array",
      "default": null,
      "required": false
    }
  ],
  "rules": [
    {
      "cel": "size(params.image_references) == 1",
      "message": "exactly one image_references entry is required"
    }
  ],
  "type": "image"
}
