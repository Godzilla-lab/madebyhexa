{
  "display_name": "Bytedance Image Upscale",
  "job_type": "bytedance_image_upscale",
  "params": [
    {
      "name": "image_references",
      "type": "array",
      "default": null,
      "required": false
    },
    {
      "name": "resolution",
      "type": "string",
      "default": "4k",
      "required": false,
      "enum": [
        "2k",
        "4k"
      ]
    }
  ],
  "rules": [
    {
      "cel": "size(params.image_references) == 1",
      "message": "exactly one image_references entry is required"
    }
  ],
  "type": "image"
}
