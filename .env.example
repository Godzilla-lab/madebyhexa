# Copy to .env for local `netlify dev`, and set the same keys in Netlify
# (all contexts — the Free plan needs all-context scope to read them in functions).
# Real values are NOT committed: .env is gitignored.

# --- Higgsfield (generation engine) ---
HIGGSFIELD_TOKEN=
HIGGSFIELD_WORKSPACE_ID=
# Auto-refresh (recommended: HIGGSFIELD_TOKEN alone goes stale after ~24h).
# Seed both at once with: node tools/hf-seed-token.js <oauth_client_id>
HIGGSFIELD_REFRESH_TOKEN=
HIGGSFIELD_OAUTH_CLIENT_ID=  # public PKCE id, visible in the CLI's login URL
RENDER_DEV_KEY=              # lets you test renders without a real payment

# --- Stripe (payments) ---
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_STARTER=
STRIPE_PRICE_GROWTH=

# --- Supabase (auth + database) ---
SUPABASE_URL=https://xsfxsnqmhaogfsgdjjeg.supabase.co
SUPABASE_ANON_KEY=           # sb_publishable_... — public, ships in the browser
SUPABASE_SERVICE_ROLE_KEY=   # sb_secret_... — SERVER ONLY, never expose to the browser

# --- Email (Zoho SMTP; reused for Supabase auth emails) ---
ZOHO_USER=
ZOHO_APP_PASSWORD=
FROM_NAME=Hexa AI

# --- Ad tracking (server-side conversions) ---
META_ACCESS_TOKEN=
TIKTOK_ACCESS_TOKEN=
